.venv/
__pycache__/
*.py[cod]
*.tmp

# Local scratch / one-off scan dumps (e.g. .tmp_scan_hl/)
.tmp*/

# Local user and machine state
nyx_game_dir.conf
game_dir.conf
# Machine-local launcher paths; never commit (leaks home dir)
farever-atlas.desktop
user_data/
user_waypoints_*.json
user_waypoints_*.json.bak
waypoints_export.json
custom_waypoints_export.json
.codex/
.agents/

# Runtime bridge output
native_bridge/farever-process.json
native_bridge/farever-telemetry.json
native_bridge/farever-telemetry.profile.txt
native_bridge/bridge.log

# Generated build output and release packages
native_bridge/target/
native_bridge/farever-atlas-bridge.exe
dist/
build/
.cache/
*.zip

# Fetched UI fonts (populated by python -m farever_atlas.fonts)
assets/fonts/*.ttf
assets/fonts/*.otf
assets/fonts/*.partial
assets/fonts/OFL.txt

# Local backups and extracted game files
.backups/
extracted/
# Intermediate tile PNGs from tools/build_map_assets.py (--keep-tiles)
extracted/map/

# Third-party research checkouts (kept locally, not vendored)
usefull/

# Local design notes / sketches
docs/
